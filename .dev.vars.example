# 複製為 .dev.vars 供本機 wrangler dev 使用（.dev.vars 已 gitignore）。
# 遠端 deploy 的 secret 改用: npx wrangler secret put <NAME>

# LINE Developers Console → Basic settings → Channel secret
LINE_CHANNEL_SECRET=

# LINE Developers Console → Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# 設為 1 時不呼叫真正的 LINE API，只在 log 印出要回的訊息。
# 本機測試 #1~#3 用；沒有 LINE 憑證也能跑通流程。
DRY_RUN=1

# 轉人工後多久自動恢復自動回覆（分鐘）
HUMAN_MODE_TIMEOUT_MIN=30
