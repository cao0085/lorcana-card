# 複製本檔為 .env 並填入實際值。.env 已列入 .gitignore，切勿提交。
# 兩個值都在 LINE Developers Console 的 Messaging API Channel 裡。

# Basic settings 分頁 -> Channel secret
LINE_CHANNEL_SECRET=

# Messaging API 分頁 -> Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# 伺服器埠號
PORT=3000

# 轉人工後多久自動恢復自動回覆（分鐘）
HUMAN_MODE_TIMEOUT_MIN=30
